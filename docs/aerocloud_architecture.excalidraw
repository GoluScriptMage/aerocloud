      "originalText": "\ud83d\udcbb CLI CLIENT (aerocloud CLI)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cli_body_txt",
      "type": "text",
      "x": 70,
      "y": 210,
      "width": 1112,
      "height": 30,
      "angle": 0,
      "strokeColor": "#495057",
      "fontSize": 12,
      "fontFamily": 1,
      "text": "\u2022 deploys zip packages\n\u2022 streams build events via SSE\n\u2022 triggers stops/destroys\n\u2022 streams follow logs (-f)\n\u2022 parses config (aerocloud.json)",
      "textAlign": "left",
      "verticalAlign": "top",
      "isDeleted": false,
      "version": 1,
      "versionNonce": 3959738,
      "seed": 2651697,
      "backgroundColor": "transparent",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786349188781,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "\u2022 deploys zip packages\n\u2022 streams build events via SSE\n\u2022 triggers stops/destroys\n\u2022 streams follow logs (-f)\n\u2022 parses config (aerocloud.json)",
      "autoResize": true,
      "lineHeight": 1.25
    },
