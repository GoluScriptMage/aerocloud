    {
      "id": "server_body_txt",
      "type": "text",
      "x": 440,
      "y": 210,
      "width": 1456,
      "height": 30,
      "angle": 0,
      "strokeColor": "#495057",
      "fontSize": 12,
      "fontFamily": 1,
      "text": "\u2022 extracts zip to deployments/\n\u2022 parses env file via dotenv\n\u2022 queries port from Port Scanner\n\u2022 compile-streams build lines\n\u2022 demuxes Docker stdout/stderr\n\u2022 handles client termination",
      "textAlign": "left",
      "verticalAlign": "top",
      "isDeleted": false,
      "version": 1,
      "versionNonce": 2650270,
      "seed": 94680,
      "backgroundColor": "transparent",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786349188781,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "\u2022 extracts zip to deployments/\n\u2022 parses env file via dotenv\n\u2022 queries port from Port Scanner\n\u2022 compile-streams build lines\n\u2022 demuxes Docker stdout/stderr\n\u2022 handles client termination",
      "autoResize": true,
      "lineHeight": 1.25
    },
