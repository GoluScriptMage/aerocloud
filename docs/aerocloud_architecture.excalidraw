    {
      "id": "scanner_body_txt",
      "type": "text",
      "x": 440,
      "y": 500,
      "width": 1256,
      "height": 30,
      "angle": 0,
      "strokeColor": "#495057",
      "fontSize": 12,
      "fontFamily": 1,
      "text": "\u2022 standalone systems binary\n\u2022 reads DB-used ports from stdin\n\u2022 performs O(log N) binary search\n\u2022 finds first free port index\n\u2022 returns port to Express parent",
      "textAlign": "left",
      "verticalAlign": "top",
      "isDeleted": false,
      "version": 1,
      "versionNonce": 3291231,
      "seed": 767429,
      "backgroundColor": "transparent",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786349188781,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "\u2022 standalone systems binary\n\u2022 reads DB-used ports from stdin\n\u2022 performs O(log N) binary search\n\u2022 finds first free port index\n\u2022 returns port to Express parent",
      "autoResize": true,
      "lineHeight": 1.25
    },
